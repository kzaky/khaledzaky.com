---
import BaseLayout from '../layouts/BaseLayout.astro';

// Prompt bodies (kept verbatim so copy-paste matches the downloadable .md files).
const contractNocode = `You are a product analyst agent. You turn raw customer feedback into a decision-grade product brief.

Rules:
- Every market or factual claim carries a source. No source, no claim.
- For every web-sourced claim, record the EXACT sentence from the source that supports it, verbatim. This sentence will be checked. If you cannot find a sentence that supports the claim, do not make the claim.
- Active voice. Lead with the decision. No adjective does an argument's job.
- Write the brief as readable prose with clear sections, in order: Problem, Evidence, Options, Recommendation, Ask.
- In the Evidence section, every claim carries its source and the exact sentence it came from. Mark any claim you cannot source as ASSUMPTION.`;

const contractBuilder = `You are a product analyst agent. You turn raw customer feedback into a decision-grade product brief.

Rules:
- Every market or factual claim carries a source. No source, no claim.
- For every web-sourced claim, record the EXACT sentence from the source that supports it, verbatim. This sentence will be checked by a verifier. If you cannot find a sentence that supports the claim, do not make the claim.
- Active voice. Lead with the decision. No adjective does an argument's job.
- Brief structure, in order: Problem, Evidence, Options, Recommendation, Ask.
- Output the final brief as a single JSON object with keys: title, recommendation, problem, claims (list of {id, kind: "web"|"internal", text, source, quote}), options (list of {name, note}), ask.

Tools: read_feedback(path), web_search(query).`;

const p01 = `Read data/freshcart_feedback.csv: app reviews, support tickets, and NPS verbatims from the last 90 days.

Cluster the complaints into at most 6 themes. For each theme give: a one-line name, the count, a severity call (HIGH / MED / LOW) with one sentence of reasoning, and 2 representative verbatims quoted exactly.

Rank by count × severity. Do not propose fixes yet.`;

const p02 = `Take the top theme. Tell me whether it is an industry-wide problem or specific to us.

Use web_search. I want: how common this is, what 2 named competitors do about it, and any benchmark on its retention or revenue impact.

For every number you report, record the source and the exact sentence it came from.`;

const p03 = `Write the brief. Problem, Evidence, Options (at least 3, include do-nothing), Recommendation (pick one, commit), Ask (what you need and from whom).

Use only claims that carry a source from the steps above. If a claim has no supporting sentence, cut it or label it ASSUMPTION. One page. Lead with the recommendation.`;

const p05 = `You are now a verifier, not a writer. Do not add, reword, or improve anything.

For each claim in the Evidence section above:
1. Open the cited source.
2. Find the exact sentence recorded for that claim. Paste the sentence you actually find in the source, verbatim, inside quotation marks. Do not paraphrase. If you cannot find it, write: NOT FOUND.
3. Check that every number in the claim appears somewhere in the source. List any number that does not.
4. Mark PASS only if the recorded sentence is present verbatim and every number appears. Otherwise mark FAIL and say exactly what is missing.

Return a table: Claim | Source | Sentence found in source (verbatim, or NOT FOUND) | Numbers missing | PASS or FAIL.

If any claim fails, list it under "Blocked. Do not ship." Do not fix it for me. I decide what happens next.

I will read the sentence you found and compare it to the sentence recorded earlier myself. Your job is to fetch and report, not to judge.`;

const gateRule = `Every fact has to carry the exact sentence it came from.
Something has to go back and check that the sentence is really there.

web claim  → is claim["quote"] present in the cited source?  every number present?
internal   → recompute it from the data. never trust the stated count.
any fail   → block. do not warn. warnings get ignored.`;

const p06 = `Produce the evidence pack for this brief. A table with one row per claim: the claim, its source, whether it passed verification, and the exact supporting sentence. Below the table, four lines: Groundedness (claims supported out of total), Completion (are all five brief sections present), Cost (if known), Latency (if known). Nothing else. This is a receipt, not a summary.`;

const p04 = `Turn the approved brief into a five-slide leadership deck. One decision per slide. Slide 1 is the recommendation and the ask, not an agenda. Speaker notes in a declarative, evidence-first voice.`;

const sampleBrief = `FreshCart · Smart Substitutions · Product Brief

Recommendation: Build a per-item substitution preference toggle this sprint.

Evidence:
- Substitution is the #1 complaint theme: 68 of 182 feedback items in the last 90 days. [internal data]
- 62% of FreshCart users churn after a single bad substitution. [Provision Retail Analytics, State of Grocery Delivery 2025]
- 41% of shoppers reduced order frequency after poor substitutions. [Provision Retail Analytics, State of Grocery Delivery 2025]
- InstaFresh lets customers pre-approve a substitute per item. [InstaFresh Help Center]

Options: (1) Do nothing  (2) Per-item substitution toggle  (3) Post-hoc refunds only
Ask: one sprint of engineering time, and a decision this week.`;

const controls = [
  {
    group: 'What goes in',
    items: [
      ['01', 'Source of record', 'Every input is traceable to where it came from.'],
      ['02', 'Grounding contract', 'Every claim carries the exact sentence it came from.'],
      ['03', 'Scope boundary', 'The agent knows what it may and may not touch.'],
    ],
  },
  {
    group: 'What comes out',
    items: [
      ['04', 'Structured artifact', 'Output has a required shape: Problem, Evidence, Options, Recommendation, Ask.'],
      ['05', 'Groundedness check', 'Ordinary code re-checks each claim against its source.'],
      ['06', 'Fail-closed gate', 'A failed check stops the brief from shipping.'],
    ],
  },
  {
    group: 'What proves it',
    items: [
      ['07', 'Evidence pack', 'The receipt: each claim with its source and whether it passed.'],
      ['08', 'Run metrics', 'Groundedness, completion, cost per run, latency.'],
      ['09', 'Regression set', 'The same checks rerun on every change.'],
    ],
  },
];

const jumpLinks = [
  ['#controls', 'The nine controls'],
  ['#setup', 'Setup'],
  ['#modules', 'Seven modules'],
  ['#checklist', 'Checklist'],
  ['#handout', 'Handout'],
];
---

<BaseLayout
  title="Build an AI Analyst You Can Trust"
  description="Rebuild the FreshCart analyst from the BrainStation session: nine controls, two tracks, every prompt copy-paste."
>
  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-10">
    <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-3">
      Workshop companion · from the BrainStation session · run it after, at your own pace
    </p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white font-serif mb-6">
      Build an AI analyst you can trust.
    </h1>

    <blockquote class="border-l-4 border-primary-500 bg-primary-50 dark:bg-primary-950/30 rounded-r-lg px-5 py-4 text-lg md:text-xl leading-snug text-gray-900 dark:text-gray-100 mb-6">
      Every fact has to carry the exact sentence it came from.<br />
      Something has to go back and check that the sentence is really there.
    </blockquote>

    <p class="mb-8 print:hidden">
      <a href="#try" class="btn-solid btn-tap">Try the check in 2 minutes</a>
    </p>

    <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
      Everything on this page is a way to make that rule run without anyone having to remember it. You'll
      rebuild the analyst I showed on stage. It reads 182 real-looking complaints, finds the biggest problem, pulls
      in outside evidence, and writes a one-page recommendation. Somewhere along the way it invents a statistic,
      and then it gets caught.
    </p>

    <!-- Facts -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
      {[
        ['2 tracks', 'No-code in Claude.ai, or the builder track with Claude Code and the repo.'],
        ['9 controls', "The part that doesn't depend on any tool, so it outlasts the next model release."],
        ['7 modules', 'Every prompt is copy-paste. Budget about an hour the first time.'],
      ].map(([big, small]) => (
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-5">
          <div class="text-2xl font-bold font-serif text-gray-900 dark:text-white tabular-nums">{big}</div>
          <div class="text-sm text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">{small}</div>
        </div>
      ))}
    </div>

    <!-- Jump links -->
    <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2 print:hidden">
      {jumpLinks.map(([href, label]) => (
        <a
          href={href}
          class="text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:border-primary-300 dark:hover:border-primary-700 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>
  </section>

  <!-- Try the check in 2 minutes (phone-friendly / in-session hands-on) -->
  <section id="try" class="max-w-4xl mx-auto px-6 py-14 border-t border-gray-200 dark:border-gray-800 scroll-mt-20">
    <div class="rounded-2xl border border-primary-200 dark:border-primary-900/60 bg-primary-50/50 dark:bg-primary-950/20 p-4 sm:p-6 md:p-8">
      <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-2">Try the check in 2 minutes · works on your phone</p>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-serif mb-3">
        Catch a fabricated number yourself.
      </h2>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl mb-6">
        Open <a href="https://claude.ai" rel="noopener" class="text-primary-600 dark:text-primary-400 hover:underline">Claude.ai</a> in a new chat
        and paste these three in order. The brief has one invented statistic. Watch whether the check
        catches it. Some runs do, some mark everything NOT FOUND because they can't open the source, and some cheerfully pass it.
      </p>

      <div class="space-y-3">
        <div class="promptbox">
          <div class="promptbar"><span>1 · The contract · paste first</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/00-system-contract-nocode.md" download>.md</a></span></div>
          <pre>{contractNocode}</pre>
        </div>
        <div class="promptbox">
          <div class="promptbar"><span>2 · The sample brief · one claim is fake</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/sample-brief.md" download>.md</a></span></div>
          <pre>{sampleBrief}</pre>
        </div>
        <div class="promptbox">
          <div class="promptbar"><span>3 · The verifier · run the check</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/05-gate-nocode.md" download>.md</a></span></div>
          <pre>{p05}</pre>
        </div>
      </div>
      <details class="reveal mt-4">
        <summary>Ran it? Tap to see which claim is fake.</summary>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-3">
          The invented one is <b class="text-gray-900 dark:text-white">62% churn</b>. It's cited to a report that only
          says 41% <em>reduced order frequency</em>, and the report never says 62 or "churn." If your chat verifier
          claims it found the sentence, it's wrong. If it marked every claim NOT FOUND, it couldn't reach the source at all,
          and a chat window can't fix that either. That's the reason I wrote the builder track's check in code, with the source in hand.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-3">
          FreshCart, InstaFresh and Provision Retail Analytics are made up for the workshop, so there's no real report
          for a chat to open. The report's text lives in the repo's fixtures. The failure mode is real.
        </p>
      </details>
    </div>
  </section>

  <!-- Nine controls -->
  <section id="controls" class="max-w-4xl mx-auto px-6 py-16 border-t border-gray-200 dark:border-gray-800 scroll-mt-20">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-serif mb-4">
      The nine controls.
    </h2>
    <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mb-8">
      The tools change every quarter, so I picked controls that don't depend on any of them. Each module below
      names the controls it implements. When Claude Code gets replaced by whatever comes next, you'll still know
      what you're building.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {controls.map(({ group, items }) => (
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-900 px-4 py-2.5 border-b border-gray-200 dark:border-gray-800">
            {group}
          </h3>
          <div class="divide-y divide-gray-100 dark:divide-gray-800/60">
            {items.map(([n, name, desc]) => (
              <div class="flex gap-3 px-4 py-3">
                <span class="text-primary-600 dark:text-primary-400 font-bold font-serif tabular-nums shrink-0">{n}</span>
                <div>
                  <div class="font-semibold text-gray-900 dark:text-white text-sm">{name}</div>
                  <div class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mt-0.5">{desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mt-12 mb-3">Where the nine controls come from</h3>
    <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mb-4">
      I didn't invent these. They're my translation of where regulators and standards bodies are converging,
      turned into things you can build in an afternoon. The mapping below is by function, not clause by clause,
      so check the source text before you cite it in your own work.
    </p>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-800">
      <table class="w-full text-sm stack-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-800">
            <th class="px-4 py-3 font-semibold align-top">Controls</th>
            <th class="px-4 py-3 font-semibold align-top">What they answer</th>
            <th class="px-4 py-3 font-semibold align-top">Where the same idea appears</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800/60 text-gray-700 dark:text-gray-300">
          <tr>
            <td class="px-4 py-3 align-top font-medium">01 to 03 · what goes in</td>
            <td data-label="What they answer" class="px-4 py-3 align-top">Can you trace inputs, and is the system operating inside a defined boundary?</td>
            <td data-label="Where the same idea appears" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">NIST AI RMF (Map and Govern) · ISO/IEC 42001 (system scope and data management) · EU AI Act (data governance and record-keeping)</td>
          </tr>
          <tr>
            <td class="px-4 py-3 align-top font-medium">04 to 06 · what comes out</td>
            <td data-label="What they answer" class="px-4 py-3 align-top">Is the output tested against a standard, and does failure stop the line?</td>
            <td data-label="Where the same idea appears" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">NIST AI RMF (Measure and Manage) · OSFI Guideline E-23 (model validation) · EU AI Act (accuracy, robustness, human oversight)</td>
          </tr>
          <tr>
            <td class="px-4 py-3 align-top font-medium">07 to 09 · what proves it</td>
            <td data-label="What they answer" class="px-4 py-3 align-top">Can a third party reconstruct what happened and see it still holds?</td>
            <td data-label="Where the same idea appears" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">NIST AI RMF (Govern, documentation) · ISO/IEC 42001 (monitoring and records) · OSFI E-23 (ongoing monitoring) · EU AI Act (logging and post-market monitoring)</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-4">
      Your engineer would call this an eval, your risk team a guardrail, and your regulator governance. It's the
      same nine controls seen from three different chairs.
    </p>
  </section>

  <!-- Setup -->
  <section id="setup" class="max-w-4xl mx-auto px-6 py-16 border-t border-gray-200 dark:border-gray-800 scroll-mt-20">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-serif mb-6">
      Pick a track and set it up once.
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-5">
        <div class="font-semibold text-gray-900 dark:text-white mb-1">No-code</div>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          A free <a href="https://claude.ai" rel="noopener" class="text-primary-600 dark:text-primary-400 hover:underline">Claude.ai</a> account
          with web search turned on. There's nothing to install.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Pick this if you care more about the habit and the artifacts than the code. Anyone in the room can do it.</p>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-5">
        <div class="font-semibold text-gray-900 dark:text-white mb-1">Builder</div>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          <a href="https://code.claude.com/docs/en/overview" rel="noopener" class="text-primary-600 dark:text-primary-400 hover:underline">Claude Code</a> installed,
          an Anthropic API key, Python 3.11+, and the repo.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Pick this if you want the gate running as code on every run, whether or not you're watching.</p>
      </div>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-4">
      Both tracks follow the same seven modules and produce the same artifacts. The builder track adds the automatic check.
    </p>

    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mt-10 mb-3">What you should see, no-code track</h3>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-800">
      <table class="w-full text-sm stack-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-800">
            <th class="px-4 py-3 font-semibold align-top">After module</th>
            <th class="px-4 py-3 font-semibold align-top">You should have</th>
            <th class="px-4 py-3 font-semibold align-top">If not</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800/60 text-gray-700 dark:text-gray-300">
          <tr><td class="px-4 py-3 align-top font-medium tabular-nums"><span class="sm:hidden">After module </span>03</td><td data-label="You should have" class="px-4 py-3 align-top">A ranked table, 4 to 6 themes, counts, a HIGH/MED/LOW call each, two quoted verbatims per theme.</td><td data-label="If not" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">Re-attach the CSV. Ask it to count, not estimate.</td></tr>
          <tr><td class="px-4 py-3 align-top font-medium tabular-nums"><span class="sm:hidden">After module </span>04</td><td data-label="You should have" class="px-4 py-3 align-top">Two or three outside numbers, each with a URL and an exact sentence. At least one that sounds a little too clean.</td><td data-label="If not" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">Confirm web search is on. Tell it: "If you cannot find a sentence, say so. Do not paraphrase."</td></tr>
          <tr><td class="px-4 py-3 align-top font-medium tabular-nums"><span class="sm:hidden">After module </span>05</td><td data-label="You should have" class="px-4 py-3 align-top">A one-page brief with five sections, recommendation first.</td><td data-label="If not" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">Ask for the missing section by name.</td></tr>
          <tr><td class="px-4 py-3 align-top font-medium tabular-nums"><span class="sm:hidden">After module </span>06</td><td data-label="You should have" class="px-4 py-3 align-top">A verification table. Usually one row fails. <b>You</b> read the found sentence and decide.</td><td data-label="If not" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">If every row passes, open two sources yourself. Chat verifiers are generous.</td></tr>
          <tr><td class="px-4 py-3 align-top font-medium tabular-nums"><span class="sm:hidden">After module </span>07</td><td data-label="You should have" class="px-4 py-3 align-top">An evidence table and four metric lines.</td><td data-label="If not" class="px-4 py-3 align-top text-gray-500 dark:text-gray-400">Paste Prompt 06 again with "table only."</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Seven modules -->
  <section id="modules" class="max-w-4xl mx-auto px-6 py-16 border-t border-gray-200 dark:border-gray-800 scroll-mt-20">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-serif mb-6">
      Seven modules.
    </h2>

    <div class="flex gap-2 mb-2 print:hidden" role="group" aria-label="Choose a track">
      <button type="button" data-track="a" aria-pressed="true"
        class="track-btn text-sm font-medium px-4 py-2 rounded-full border border-gray-300 dark:border-gray-700 transition-colors">No-code track</button>
      <button type="button" data-track="b" aria-pressed="false"
        class="track-btn text-sm font-medium px-4 py-2 rounded-full border border-gray-300 dark:border-gray-700 transition-colors">Builder track</button>
    </div>

    <div class="divide-y divide-gray-200 dark:divide-gray-800">
      <!-- Module 01 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">01</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Get the mess</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements control 01 · source of record</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Download the sample feedback file below, or export 90 days of your own: app reviews, support tickets, survey comments, all in one CSV.</li>
              <li>One row per comment. Keep a column for where it came from.</li>
            </ol>
            <p class="mt-4"><a class="btn-outline" href="/trust/freshcart_feedback.csv" download>Download freshcart_feedback.csv</a></p>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Clone the repo. The same CSV is in <code>data/</code>, plus a <code>theme_truth</code> column the gate uses to recompute counts.</li>
              <li>Or drop your own file in its place with the same columns.</li>
            </ol>
            <p class="mt-4"><a class="btn-outline" href="https://github.com/kzaky/freshcart-agent" rel="noopener">Get the repo</a></p>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> Everything downstream is only as good as this file. If you can't say where a row came from, you can't verify anything built on it.</p>
        </div>
      </article>

      <!-- Module 02 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">02</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Write the contract</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements controls 02 &amp; 03 · grounding contract and scope boundary</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Open a new chat in Claude.ai.</li>
              <li>Paste the contract below as your first message. It sets one rule the whole session depends on: every fact carries the exact sentence it came from.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>The contract · paste into: Claude.ai, first message of a new chat</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/00-system-contract-nocode.md" download>.md</a></span></div>
              <pre>{contractNocode}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Read <code>prompts/system.md</code>. It's the system prompt the agent runs under.</li>
              <li>Look for the line about the verifier. The gate enforces that sentence later.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>The contract · prompts/system.md, already in the repo</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/00-system-contract.md" download>.md</a></span></div>
              <pre>{contractBuilder}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> If you keep one sentence from this workshop, make it this one: <em>every fact carries the sentence it came from, and something goes and checks.</em> I say it to every team I work with. The rest is implementation.</p>
        </div>
      </article>

      <!-- Module 03 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">03</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Find the themes</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements control 04 · structured artifact</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Attach the CSV to the chat.</li>
              <li>Paste the clustering prompt. You'll get a ranked table of themes with counts and severity, and no fixes yet.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 01 · paste into: the same Claude.ai chat</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/01-cluster.md" download>.md</a></span></div>
              <pre>{p01}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Run <code>make demo</code> and watch the agent read, cluster, and rank. The table prints in the terminal.</li>
              <li>When it finishes, open <code>out/brief.html</code> to see the rendered brief.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 01 · prompts/01_cluster.md</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/01-cluster.md" download>.md</a></span></div>
              <pre>{p01}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> Nobody told the model what the categories were. It found them on its own. Ranking by count times severity turns a pile of complaints into something you can decide on.</p>
        </div>
      </article>

      <!-- Module 04 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">04</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Ground it</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements control 02 again · the sentence rule under pressure</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Turn on web search in Claude.ai.</li>
              <li>Paste the grounding prompt. For every number it reports, it has to record the exact sentence it came from. When it hands you a clean, punchy number, get suspicious.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 02 · paste into: the same chat, web search on</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/02-ground.md" download>.md</a></span></div>
              <pre>{p02}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>This happens inside <code>make demo</code> and replays identically every time. I engineered the failure on purpose: a realistic case of citation drift that shows up the same way on every run, so you're never waiting on a live glitch.</li>
              <li>The brief carries a 62% churn figure cited to a real-looking report that never says 62 and never says churn. It's captured in <code>fixtures/captured_run.json</code>, and the gate runs against it for real.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 02 · prompts/02_ground.md</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/02-ground.md" download>.md</a></span></div>
              <pre>{p02}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> Ask a model for a churn number when the source only has an adjacent one, and it'll often round the real finding up into something punchier that fits the story. It's pattern-matching, and the result reads fine. You won't catch it by reading.</p>
        </div>
      </article>

      <!-- Module 05 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">05</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Write the brief</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements control 04 · and the setup for control 05</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Paste the synthesis prompt. You'll get a one-page brief: Problem, Evidence, Options, Recommendation, Ask.</li>
              <li>Don't ship it yet.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 03 · paste into: the same chat</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/03-synthesize.md" download>.md</a></span></div>
              <pre>{p03}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Already done by <code>make demo</code>. The brief is in <code>out/brief.html</code> with the 62% claim sitting in the Evidence list looking exactly like the real ones.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 03 · prompts/03_synthesize.md</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/03-synthesize.md" download>.md</a></span></div>
              <pre>{p03}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> Lead with the recommendation, and include do-nothing as an option. A brief that can't say what happens if you do nothing hasn't earned its ask.</p>
        </div>
      </article>

      <!-- Module 06 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">06</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Build the gate</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements controls 05 &amp; 06 · groundedness check and fail-closed</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Paste the verifier prompt. Claude fetches each cited source and pastes the sentence it actually finds, and <b>you compare</b> the two. If the recorded sentence isn't in the source, or a number is missing, it's a <span class="fail">FAIL</span>.</li>
              <li>Anything that fails gets removed or labelled ASSUMPTION before the brief goes anywhere.</li>
              <li class="text-gray-500 dark:text-gray-400">A caveat: in this track the machine fetches and you judge. The fully automatic check needs the builder track, because an AI checking an AI can be wrong in the same direction as the writer.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 05 · paste into: the same chat, after the brief</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/05-gate-nocode.md" download>.md</a></span></div>
              <pre>{p05}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Run <code>make gate</code>. It fails on exactly one claim and tells you why: quoted sentence not found, 62% not in source, nearest real figure 41%.</li>
              <li>Run <code>make fix</code>, then <code>make gate</code> again. It passes and writes the evidence pack.</li>
              <li>Then open <code>freshcart_agent/gate.py</code>. It's about sixty lines of ordinary code with no AI in it. In <code>workshop/</code> the same file is a TODO for you to build yourself.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>The rule the gate enforces</span></div>
              <pre>{gateRule}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> <span class="fail">Fail-closed</span> means a failed check blocks the brief. In my experience, warn-only checks get ignored by the third week. And the gate stays on after launch, permanently.</p>
        </div>
      </article>

      <!-- Module 07 -->
      <article class="py-8">
        <div class="flex items-baseline gap-4">
          <span class="text-3xl font-bold font-serif text-primary-600 dark:text-primary-400 tabular-nums shrink-0 w-12">07</span>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Ship the receipt</h3>
        </div>
        <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 mt-1 mb-4 ml-16">Implements controls 07, 08 &amp; 09 · evidence pack, run metrics, regression</p>
        <div class="ml-0 sm:ml-16">
          <div class="track-a" data-label="No-code track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li>Paste the evidence-pack prompt. You'll get a table with every claim, its source, pass or fail, and the supporting sentence.</li>
              <li>Save it next to the brief. Six months from now, when someone asks where a number came from, this is what you hand them.</li>
              <li>Optional: paste Prompt 04 to turn the approved brief into a five-slide deck.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 06 · paste into: the same chat, after the gate</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/06-evidence-pack.md" download>.md</a></span></div>
              <pre>{p06}</pre>
            </div>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 04 · optional · paste into: the same chat, after the brief is approved</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/04-deck.md" download>.md</a></span></div>
              <pre>{p04}</pre>
            </div>
          </div>
          <div class="track-b hidden" data-label="Builder track">
            <ol class="list-decimal ml-5 space-y-1.5 text-gray-700 dark:text-gray-300 leading-relaxed">
              <li><code>make gate</code> already wrote <code>out/evidence_pack.html</code> and printed four operator metrics: groundedness, completion, cost per run, latency.</li>
              <li><code>make deck</code> turns the approved brief into five slides.</li>
              <li><code>make preflight</code> is the regression set. Run it before every demo, and in CI before every prompt change.</li>
            </ol>
            <div class="promptbox">
              <div class="promptbar"><span>Prompt 04 · prompts/04_deck.md</span><span class="flex items-center gap-2"><button type="button" class="copy">Copy</button> <a href="/trust/prompts/04-deck.md" download>.md</a></span></div>
              <pre>{p04}</pre>
            </div>
          </div>
          <p class="why"><b class="text-gray-900 dark:text-white font-semibold">Why this matters.</b> Groundedness is the metric I see tracked least, and it's the one that hurts most when it's wrong. Cost and latency tell you whether this can sit inside a real workflow. The evidence pack is what a regulated team needs before it'll run something like this.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Checklist -->
