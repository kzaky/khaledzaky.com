<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.track-btn');
    function setTrack(t) {
      document.querySelectorAll('.track-a').forEach(function (el) { el.classList.toggle('hidden', t !== 'a'); });
      document.querySelectorAll('.track-b').forEach(function (el) { el.classList.toggle('hidden', t !== 'b'); });
      btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.track === t)); });
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { setTrack(b.dataset.track); }); });
    setTrack('a');

    // Copy: async Clipboard API first, execCommand fallback (older in-app browsers),
    // and if both fail, select the text so a long-press copy still works.
    function legacyCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.left = '0'; ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select(); ta.setSelectionRange(0, text.length);
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }
    function flash(b, msg) {
      clearTimeout(b._t); b.textContent = msg;
      b._t = setTimeout(function () { b.textContent = 'Copy'; }, 1800);
    }
    document.querySelectorAll('.copy').forEach(function (b) {
      b.setAttribute('aria-live', 'polite');
      b.addEventListener('click', function () {
        var pre = b.closest('.promptbox').querySelector('pre');
        var text = pre.textContent;
        function fail() {
          if (legacyCopy(text)) { flash(b, 'Copied'); return; }
          var r = document.createRange(); r.selectNodeContents(pre);
          var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
          flash(b, 'Selected');
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () { flash(b, 'Copied'); }, fail);
        } else { fail(); }
      });
    });

    // Printed copies should include the answer to the Try block.
    window.addEventListener('beforeprint', function () {
      document.querySelectorAll('details.reveal').forEach(function (d) { d.open = true; });
    });

    var printBtn = document.getElementById('print-btn');
    if (printBtn) printBtn.addEventListener('click', function () { window.print(); });
  })();
</script>
