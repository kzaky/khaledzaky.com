{
  "Comment": "Blog Agent Pipeline: Research → Draft → Verify → Chart → HITL Review → Publish",
  "StartAt": "Research",
  "States": {
    "Research": {
      "Type": "Task",
      "Resource": "${ResearchFunction.Arn}",
      "ResultPath": "$.research_output",
      "Next": "Draft",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "RuntimeError"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "Draft": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${DraftFunction.Arn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "topic.$": "$.research_output.topic",
          "categories.$": "$.research_output.categories",
          "research.$": "$.research_output.research",
          "author_content.$": "$.research_output.author_content",
          "tone.$": "$.research_output.tone",
          "goal.$": "$.research_output.goal",
          "avoid.$": "$.research_output.avoid",
          "analogies.$": "$.research_output.analogies",
          "suggested_title.$": "$.research_output.suggested_title",
          "suggested_description.$": "$.research_output.suggested_description",
          "preserve_source.$": "$.research_output.preserve_source",
          "execution_id.$": "$$.Execution.Name"
        }
      },
      "HeartbeatSeconds": 600,
      "TimeoutSeconds": 3600,
      "ResultPath": "$.draft_output",
      "Next": "VerifyCitations",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "RuntimeError"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.HeartbeatTimeout",
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "VerifyCitations": {
      "Type": "Task",
      "Resource": "${VerifyFunction.Arn}",
      "Parameters": {
        "title.$": "$.draft_output.title",
        "slug.$": "$.draft_output.slug",
        "categories.$": "$.draft_output.categories",
        "description.$": "$.draft_output.description",
        "markdown.$": "$.draft_output.markdown",
        "date.$": "$.draft_output.date",
        "research.$": "$.research_output.research",
        "author_content.$": "$.research_output.author_content",
        "preserve_source.$": "$.research_output.preserve_source"
      },
      "ResultPath": "$.verify_output",
      "Next": "PruneBeforeEvaluate",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "PruneBeforeEvaluate": {
      "Comment": "Every stage echoes the full post body, so state accumulated four near-identical copies and Evaluate's result broke the 256 KB limit. draft_output.markdown is dead once VerifyCitations has produced its own copy: only title, description and validation_report are read later.",
      "Type": "Pass",
      "Parameters": {
        "research_output.$": "$.research_output",
        "verify_output.$": "$.verify_output",
        "draft_output": {
          "title.$": "$.draft_output.title",
          "description.$": "$.draft_output.description",
          "validation_report.$": "$.draft_output.validation_report"
        }
      },
      "Next": "Evaluate"
    },
    "Evaluate": {
      "Type": "Task",
      "Resource": "${EvaluateFunction.Arn}",
      "Parameters": {
        "title.$": "$.verify_output.title",
        "slug.$": "$.verify_output.slug",
        "categories.$": "$.verify_output.categories",
        "description.$": "$.verify_output.description",
        "markdown.$": "$.verify_output.markdown",
        "date.$": "$.verify_output.date",
        "verification.$": "$.verify_output.verification",
        "research.$": "$.research_output.research",
        "author_content.$": "$.research_output.author_content"
      },
      "ResultPath": "$.evaluate_output",
      "Next": "PruneBeforeCharts",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "PruneBeforeCharts": {
      "Comment": "Same reason: verify_output.markdown is superseded by evaluate_output.markdown and only verify_output.verification is read downstream, so the stale copy is dropped before GenerateCharts adds another.",
      "Type": "Pass",
      "Parameters": {
        "research_output.$": "$.research_output",
        "draft_output.$": "$.draft_output",
        "evaluate_output.$": "$.evaluate_output",
        "verify_output": {
          "verification.$": "$.verify_output.verification"
        }
      },
      "Next": "GenerateCharts"
    },
    "GenerateCharts": {
      "Type": "Task",
      "Resource": "${ChartFunction.Arn}",
      "Parameters": {
        "title.$": "$.evaluate_output.title",
        "slug.$": "$.evaluate_output.slug",
        "categories.$": "$.evaluate_output.categories",
        "description.$": "$.evaluate_output.description",
        "markdown.$": "$.evaluate_output.markdown",
        "date.$": "$.evaluate_output.date",
        "research.$": "$.research_output.research"
      },
      "ResultPath": "$.chart_output",
      "Next": "NotifyForReview",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "NotifyForReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${NotifyFunction.Arn}",
        "Payload": {
          "title.$": "$.chart_output.title",
          "slug.$": "$.chart_output.slug",
          "categories.$": "$.chart_output.categories",
          "description.$": "$.chart_output.description",
          "markdown.$": "$.chart_output.markdown",
          "date.$": "$.chart_output.date",
          "charts.$": "$.chart_output.charts",
          "verification.$": "$.verify_output.verification",
          "evaluation.$": "$.evaluate_output.evaluation",
          "validation_report.$": "$.draft_output.validation_report",
          "author_content.$": "$.research_output.author_content",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.approval",
      "TimeoutSeconds": 604800,
      "Next": "CheckApproval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "HITLExpired"
        },
        {
          "ErrorEquals": [
            "Rejected"
          ],
          "ResultPath": "$.error",
          "Next": "Rejected"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "CheckApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approval.approved",
          "BooleanEquals": true,
          "Next": "Publish"
        },
        {
          "Variable": "$.approval.revise",
          "BooleanEquals": true,
          "Next": "PruneForRevise"
        }
      ],
      "Default": "Rejected"
    },
    "PruneForRevise": {
      "Type": "Pass",
      "Parameters": {
        "research_output.$": "$.research_output",
        "draft_output": {
          "title.$": "$.draft_output.title",
          "description.$": "$.draft_output.description"
        },
        "chart_output": {
          "markdown.$": "$.chart_output.markdown"
        },
        "approval.$": "$.approval"
      },
      "Next": "Revise"
    },
    "Revise": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${DraftFunction.Arn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "topic.$": "$.research_output.topic",
          "categories.$": "$.research_output.categories",
          "research.$": "$.research_output.research",
          "author_content.$": "$.research_output.author_content",
          "tone.$": "$.research_output.tone",
          "goal.$": "$.research_output.goal",
          "avoid.$": "$.research_output.avoid",
          "analogies.$": "$.research_output.analogies",
          "suggested_title.$": "$.draft_output.title",
          "suggested_description.$": "$.draft_output.description",
          "preserve_source.$": "$.research_output.preserve_source",
          "previous_draft.$": "$.chart_output.markdown",
          "feedback.$": "$.approval.feedback",
          "execution_id.$": "$$.Execution.Name"
        }
      },
      "HeartbeatSeconds": 600,
      "TimeoutSeconds": 3600,
      "ResultPath": "$.draft_output",
      "Next": "VerifyCitations",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.HeartbeatTimeout",
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "Publish": {
      "Type": "Task",
      "Resource": "${PublishFunction.Arn}",
      "Parameters": {
        "approved": true,
        "title.$": "$.chart_output.title",
        "slug.$": "$.chart_output.slug",
        "date.$": "$.chart_output.date",
        "charts.$": "$.chart_output.charts"
      },
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ]
    },
    "HITLExpired": {
      "Type": "Succeed",
      "Comment": "Draft approval window expired — execution closed silently, no alarm"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    },
    "Rejected": {
      "Type": "Succeed",
      "Comment": "Draft was rejected by reviewer"
    }
  }
}
