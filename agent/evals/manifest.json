{
  "_doc": "Ground truth for the blog-agent eval harness. Each entry is a hand fix the author made to a post AFTER the pipeline published it: 'before' is the parent commit's file (what the pipeline shipped), 'after' is the commit's file (what a human wanted). Classes: rendering | citation | overclaim | ai_pattern | voice | content_loss | spelling | visual. build_cases.py materialises these into cases/*.json so the harness runs on a shallow checkout.",
  "classes": {
    "rendering": "structure/markup integrity: fenced body, nested frontmatter, raw notes published, SVG overflow",
    "citation": "wrong, missing, broken or mismatched source links",
    "overclaim": "precision or certainty the source does not support",
    "ai_pattern": "generated-sounding cadence: antithesis, three-beat closers, stacked contrasts, formula repeats",
    "voice": "not how the author writes: employer as authority, lost credibility hook, spelling convention",
    "content_loss": "sections or claims dropped by a rewrite pass",
    "spelling": "British -ise where the author writes -ize",
    "visual": "missing, broken or off-brand figures: ASCII art left in code blocks, a chart that misstates its data, a long post with no figures"
  },
  "cases": [
